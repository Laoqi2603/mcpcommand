# 代码风格统一（编辑器层面），与 Fabric 官方模板保持一致
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Windows 脚本保持 CRLF
[*.{bat,cmd}]
end_of_line = crlf

# Java：本工程统一用 Tab 缩进（见 README「代码风格」）
[*.java]
indent_style = tab
indent_size = 4

[*.{gradle,json,yml,yaml}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.md]
# Markdown 里行尾两个空格表示换行，不要被编辑器吃掉
trim_trailing_whitespace = false
